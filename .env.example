# Copy to .env for local (non-Docker) development. docker-compose.yml injects its own values.

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://genomics:genomics_secret@localhost:5432/genomics_db

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=genomic-datasets
S3_REGION=us-east-1

# ETL tuning
ETL_BATCH_SIZE=100000
DB_CHUNK_SIZE=25000
