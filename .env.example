# Copy to .env for local (non-Docker) development. docker-compose.yml injects its own values.
# These are throwaway local-development credentials, not real secrets.

DATABASE_URL=postgresql+psycopg://variants:variants@localhost:5432/variants
REDIS_URL=redis://localhost:6379/0

# S3 endpoint used inside the network (workers, API) ...
S3_ENDPOINT_URL=http://localhost:9000
# ... and the endpoint embedded in presigned URLs, which the *client* must be able to reach.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=variant-etl
S3_REGION=us-east-1

CHUNK_SIZE=100000
